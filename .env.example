# Yandex Vision OCR. Use one authentication method; do not commit actual values.
YANDEX_VISION_API_KEY=
YANDEX_VISION_IAM_TOKEN=
YANDEX_CLOUD_FOLDER_ID=

# Existing deployments may use compatible aliases: YANDEX_API_KEY,
# YANDEX_FOLDER_ID, YANDEX_OCR_ENDPOINT, YANDEX_OCR_MODEL,
# and YANDEX_OCR_LANGUAGES. Prefer the variables above for new setup.

# Telegram long-polling adapter. Keep this value only in local .env.
# Polling refuses to start if Telegram reports an existing webhook.
TELEGRAM_BOT_TOKEN=

# Service behavior defaults (not secrets).
OCR_MAX_FILE_SIZE_BYTES=10485760
OCR_LANGUAGE_CODES=ru,en
OCR_FIXTURES_DIR=fixtures/vision

# Optional local diagnostic evidence after a manually authorized OCR call.
# It stores only response structure, geometry, and numeric tokens—not raw OCR text.
# Keep this directory ignored by Git; leave empty in normal use.
OCR_DIAGNOSTICS_DIR=

# Input preprocessing for multipage TIFF/PDF. PDF pages with a usable text
# layer are extracted locally; only rendered scan pages are sent to Vision.
OCR_MAX_PAGES=20
OCR_MAX_JOB_SIZE_BYTES=26214400
OCR_PDF_RENDER_DPI=150
OCR_MAX_RENDERED_PIXELS=16000000
OCR_PDF_TEXT_MIN_CHARS=20

# Smart Output Delivery.
OCR_INLINE_TEXT_MAX_CHARS=2500

# Visual ruled-table recovery. Disabled by default; native Vision tables win.
OCR_ENABLE_VISUAL_TABLE_DETECTION=false

# Optional targeted second OCR pass for visibly non-empty cells in confirmed
# visual tables. It makes additional billable requests only when enabled.
OCR_ENABLE_CELL_RECOVERY=false
OCR_MAX_CELL_RECOVERY_REQUESTS=6

# Optional IMAP/SMTP Email adapter. Credentials belong only in local .env.
# The exact-address allowlist is required; unknown senders receive no reply.
OCR_EMAIL_IMAP_HOST=
OCR_EMAIL_IMAP_PORT=993
OCR_EMAIL_IMAP_SSL=true
OCR_EMAIL_IMAP_FOLDER=INBOX
OCR_EMAIL_SMTP_HOST=
OCR_EMAIL_SMTP_PORT=465
OCR_EMAIL_SMTP_SSL=true
OCR_EMAIL_SMTP_STARTTLS=false
OCR_EMAIL_USERNAME=
OCR_EMAIL_PASSWORD=
OCR_EMAIL_ADDRESS=
OCR_EMAIL_ALLOWED_SENDERS=
OCR_EMAIL_POLL_INTERVAL_SECONDS=60
OCR_EMAIL_MAX_ATTACHMENTS=5
OCR_EMAIL_MAX_ATTACHMENT_BYTES=10485760
OCR_EMAIL_STATE_PATH=local-state/email-adapter.sqlite3
